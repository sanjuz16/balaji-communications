# PostgreSQL connection string from Neon, Supabase, or another managed PostgreSQL host
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Set a long random value (at least 32 characters). Never share it publicly.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# Strong initial admin password (12+ characters). Change after first login in Security tab.
ADMIN_PASSWORD=replace-with-a-strong-password-12-chars-minimum
NODE_ENV=production
PORT=3000
# Optional: set to false only for a local PostgreSQL instance without TLS
# DATABASE_SSL=false
